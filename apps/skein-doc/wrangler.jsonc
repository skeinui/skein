// The docs site on Cloudflare: static assets only, no Worker code. `pnpm run deploy` builds and uploads it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skein-doc",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Every page is a prerendered file (scripts/prerender.ts: /button -> button.html); any other path is a real
    // 404, answered with 404.html (the app's "page not found", not indexed)
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "skeinui.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.skeinui.com",
      "custom_domain": true,
    },
  ],
}
