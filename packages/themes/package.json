{
  "name": "@skeinui/themes",
  "version": "0.0.6",
  "description": "Theme styles for Skein UI: default, shadcn, heroui, antd, plus colour, density and code themes",
  "keywords": [
    "ant-design",
    "css",
    "dark-mode",
    "design-tokens",
    "heroui",
    "react",
    "shadcn",
    "skein",
    "skeinui",
    "themes",
    "theming"
  ],
  "homepage": "https://skeinui.com",
  "bugs": "https://github.com/skeinui/skein/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skeinui/skein.git",
    "directory": "packages/themes"
  },
  "files": [
    "default",
    "shadcn",
    "heroui",
    "antd",
    "color",
    "density",
    "code",
    "vite.js",
    "vite.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./*": "./*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vp test"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@skeinui/ui": "workspace:*",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
